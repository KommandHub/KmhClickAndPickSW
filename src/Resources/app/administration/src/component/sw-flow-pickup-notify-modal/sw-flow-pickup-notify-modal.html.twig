{% block kmh_pickup_notify_modal %}
<sw-modal
    class="kmh-pickup-notify-modal"
    :title="$tc('kmh-pickup-notify-action.titleSendNotification')"
    @modal-close="onClose"
>
    {% block kmh_pickup_notify_modal_content %}
        <sw-entity-single-select
            class="kmh-pickup-notify-modal__mail-template"
            entity="mail_template"
            :value="mailTemplateId"
            :criteria="mailTemplateCriteria"
            :label="$tc('kmh-pickup-notify-action.labelMailTemplate')"
            :placeholder="$tc('kmh-pickup-notify-action.placeholderMailTemplate')"
            show-clearable-button
            @change="onMailTemplateChange"
        />

        <p class="kmh-pickup-notify-modal__hint">
            {{ $tc('kmh-pickup-notify-action.mailTemplateHint') }}
        </p>
    {% endblock %}

    {% block kmh_pickup_notify_modal_footer %}
        <template #modal-footer>
            <sw-button
                class="kmh-pickup-notify-modal__cancel-button"
                size="small"
                @click="onClose"
            >
                {{ $tc('global.default.cancel') }}
            </sw-button>

            <sw-button
                class="kmh-pickup-notify-modal__save-button"
                variant="primary"
                size="small"
                @click="onAddAction"
            >
                {{ $tc('kmh-pickup-notify-action.buttonSaveAction') }}
            </sw-button>
        </template>
    {% endblock %}
</sw-modal>
{% endblock %}
