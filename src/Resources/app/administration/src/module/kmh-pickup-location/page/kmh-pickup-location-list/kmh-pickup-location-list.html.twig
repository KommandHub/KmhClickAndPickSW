{% block kmh_pickup_location_list %}
<sw-page class="kmh-pickup-location-list">
    {% block kmh_pickup_location_list_search_bar %}
        <template #search-bar>
            <sw-search-bar
                    initial-search-type="kmh_pickup_location"
                    :initial-search="term"
                    @search="onSearch"
            />
        </template>
    {% endblock %}

    {% block kmh_pickup_location_list_smart_bar_header %}
        <template #smart-bar-header>
            {% block kmh_pickup_location_list_smart_bar_header_title %}
                <h2>
                    {% block kmh_pickup_location_list_smart_bar_header_title_text %}
                        {{ $tc('kmh-pickup-location.list.title') }}
                    {% endblock %}

                    {% block kmh_pickup_location_list_smart_bar_header_amount %}
                        <span
                                v-if="!isLoading"
                                class="sw-page__smart-bar-amount"
                        >
                            ({{ total }})
                        </span>
                    {% endblock %}
                </h2>
            {% endblock %}
        </template>
    {% endblock %}

    {% block kmh_pickup_location_list_smart_bar_actions %}
        <template #smart-bar-actions>
            {% block kmh_pickup_location_list_smart_bar_actions_slot %}

                {% block kmh_pickup_location_list_smart_bar_actions_add %}
                    <mt-button
                            v-tooltip="{
                                message: $tc('sw-privileges.tooltip.warning'),
                                disabled: acl.can('kmh_pickup_location.creator'),
                                showOnDisabledElements: true
                            }"
                            class="kmh-pickup-location-list__add-order"
                            :disabled="!acl.can('kmh_pickup_location.creator') || undefined"
                            variant="primary"
                            size="default"
                            @click="$router.push({ name: 'kmh.pickup.location.create' })"
                    >
                        {{ $tc('kmh-pickup-location.list.addButtonLabel') }}
                    </mt-button>
                {% endblock %}

            {% endblock %}
        </template>
    {% endblock %}

    {% block kmh_pickup_location_list_language_switch %}
        <template #language-switch>
            <sw-language-switch @on-change="onChangeLanguage" />
        </template>
    {% endblock %}

    {% block kmh_pickup_location_list_content %}
    <template #content>

        {% block kmh_pickup_location_list_content_slot %}
        <div class="kmh-pickup-location-list__content">

            {% block kmh_pickup_location_list_grid %}
            <sw-entity-listing
                    v-if="isLoading || (pickupLocations && entitySearchable)"
                    ref="pickupLocationGrid"
                    class="kmh-pickup-location-list-grid"
                    :items="pickupLocations"
                    :columns="getPickupLocationColumns"
                    :repository="pickupLocationRepository"
                    detail-route="kmh.pickup.location.edit"
                    :show-selection="true"
                    :is-loading="isLoading"
                    identifier="kmh-pickup-location-list"
                    :allow-edit="!acl.can('kmh_pickup_location.editor')"
                    :allow-delete="!acl.can('kmh_pickup_location.deleter')"
                    :allow-inline-edit="!acl.can('kmh_pickup_location.editor')"
                    :sort-by="currentSortBy"
                    :sort-direction="sortDirection"
                    :disable-data-fetching="true"
                    @inline-edit-save="onInlineEditSave"
                    @selection-change="updateSelection"
                    @column-sort="onSortColumn"
                    @page-change="onPageChange"
                    @update-records="updateTotal"
            >
                {% block kmh_pickup_location_list_grid_columns_salesChannel %}
                    <template #column-salesChannelId="{ item }">
                        {{ item.salesChannelId ? item.salesChannel.translated.name : $tc('kmh-pickup-location.list.salesChannel') }}
                    </template>
                {% endblock %}

                {% block kmh_pickup_location_list_grid_columns_active %}
                    <template #column-active="{ item, isInlineEdit }">
                        {% block kmh_pickup_location_list_grid_columns_active_inline_edit %}
                            <template v-if="isInlineEdit">
                                <mt-checkbox
                                        v-model:checked="item.active"
                                />
                            </template>
                        {% endblock %}

                        {% block kmh_pickup_location_list_grid_columns_active_content %}
                            <template v-else>
                                <mt-icon
                                        v-if="item.active"
                                        name="regular-checkmark-xs"
                                        size="16px"
                                        class="is--active"
                                />
                                <mt-icon
                                        v-else
                                        name="regular-times-s"
                                        size="16px"
                                        class="is--inactive"
                                />
                            </template>
                        {% endblock %}
                    </template>
                {% endblock %}

                {% block kmh_pickup_location_list_grid_columns_actions %}
                    <template #actions="{ item }">
                        {% block kmh_pickup_location_list_grid_columns_actions_edit %}
                            <sw-context-menu-item
                                    class="kmh-pickup-location-list__order-edit-action"
                                    :disabled="!acl.can('kmh_pickup_location.editor') || undefined"
                                    :router-link="{ name: 'kmh.pickup.location.edit', params: { id: item.id } }"
                            >
                                {{ $tc('kmh-pickup-location.list.contextMenuEdit') }}
                            </sw-context-menu-item>
                        {% endblock %}

                        {% block kmh_pickup_location_list_grid_columns_actions_delete %}
                            <sw-context-menu-item
                                    variant="danger"
                                    :disabled="!acl.can('kmh_pickup_location.deleter') || undefined"
                                    @click="onDelete(item.id)"
                            >
                                {{ $tc('kmh-pickup-location.list.contextMenuDelete') }}
                            </sw-context-menu-item>
                        {% endblock %}
                    </template>
                {% endblock %}

                {% block kmh_pickup_location_list_grid_action_modals %}
                <template #action-modals="{ item }">
                    {% block kmh_pickup_location_list_delete_modal %}
                    <sw-modal
                            v-if="showDeleteModal === item.id"
                            :title="$tc('kmh-pickup-location.general.deleteWarning')"
                            variant="small"
                            @modal-close="onCloseDeleteModal"
                    >
                        {% block kmh_pickup_location_list_delete_modal_confirm_delete_text %}
                        <p class="kmh-pickup-location-list__confirm-delete-text">
                            {{ $tc('kmh-pickup-location.list.textDeleteConfirm', { name: `${item.name}` }, 0) }}
                        </p>
                        {% endblock %}

                        {% block kmh_pickup_location_list_delete_modal_footer %}
                        <template #modal-footer>
                            {% block kmh_pickup_location_list_delete_modal_cancel %}
                            <mt-button
                                    size="small"
                                    variant="secondary"
                                    @click="onCloseDeleteModal"
                            >
                                {{ $tc('global.default.cancel') }}
                            </mt-button>
                            {% endblock %}

                            {% block kmh_pickup_location_list_delete_modal_confirm %}
                            <mt-button
                                variant="critical"
                                :disabled="!acl.can('kmh_pickup_location.deleter') || undefined"
                                size="small"
                                @click="onConfirmDelete(item.id)"
                                >
                                {{ $tc('kmh-pickup-location.general.buttonDelete') }}
                            </mt-button>
                            {% endblock %}
                        </template>
                        {% endblock %}
                    </sw-modal>
                    {% endblock %}
                </template>
                {% endblock %}

                <template #pagination>
                    {% block kmh_pickup_location_list_grid_pagination %}
                        <sw-pagination
                                :page="page"
                                :limit="limit"
                                :total="total"
                                :total-visible="7"
                                @page-change="onPageChange"
                        />
                    {% endblock %}
                </template>
            </sw-entity-listing>
            {% endblock %}

            {% block kmh_pickup_location_list_empty_state %}
                <template v-if="!isLoading && !total">
                    <sw-empty-state
                            v-if="filterCriteria.length || isValidTerm(term)"
                            :title="$tc('sw-empty-state.messageNoResultTitle')"
                    >
                        <template #icon>
                            <img
                                    :src="assetFilter('/administration/administration/static/img/empty-states/order-empty-state.svg')"
                                    :alt="$tc('sw-empty-state.messageNoResultTitle')"
                            >
                        </template>

                        <template #default>
                            {{ $tc('sw-empty-state.messageNoResultSublineBefore') }}
                            <router-link
                                    class="sw-empty-state__description-link"
                                    :to="{ name: 'sw.profile.index.searchPreferences' }"
                            >
                                {{ $tc('sw-empty-state.messageNoResultSublineLink') }}
                            </router-link>
                            {{ $tc('sw-empty-state.messageNoResultSublineAfter') }}
                        </template>
                    </sw-empty-state>
                    <sw-empty-state
                            v-else
                            :title="$tc('kmh-pickup-location.list.messageEmpty')"
                    >
                        <template #icon>
                            <img
                                :src="assetFilter('/administration/administration/static/img/empty-states/order-empty-state.svg')"
                                :alt="$tc('kmh-pickup-location.list.messageEmpty')"
                            >
                        </template>
                    </sw-empty-state>
                </template>
            {% endblock %}
        </div>
        {% endblock %}
    </template>
    {% endblock %}
</sw-page>
{% endblock %}
