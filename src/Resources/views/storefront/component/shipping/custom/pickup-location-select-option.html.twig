{% block pickup_location_select_option_container %}
    {% if not selectionDisabled %}
        <option value="" data-pickup-location-location-field-id-option>Please select</option>
    {% endif %}
    {% for location in locations %}
        <option class="pickup-location-location-field-id-option" value="{{ location.id }}"
                {% if selectionDisabled or location.id is same as(context.extensions.pickupLocation.id) %}selected{% endif %}>
            {{ location.name }}{% if config('KmhClickAndPickSW.config.showStreetNameInPickupLocationSelectionField') %} - {{ location.street }}{% endif %}, {{ location.city }}
        </option>
    {% endfor %}
{% endblock %}