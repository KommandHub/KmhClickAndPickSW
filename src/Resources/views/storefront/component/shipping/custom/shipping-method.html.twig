{% sw_extends '@Storefront/storefront/component/shipping/shipping-method.html.twig' %}

{% block component_shipping_method_label %}
    {{ parent() }}

    {% if config('KmhClickAndPickSW.config.enablePickupLocationSelection') %}
    {% block component_shipping_method_label_kmh_self_pickup %}
        {% if shipping.technicalName is same as('kmh_self_pickup')%}
            {% block component_shipping_method_label_kmh_self_pickup_inner %}
            {% set enableSelection = config('KmhClickAndPickSW.config.enablePickupLocationSelection') %}
            {% set salesChannelPickupLocationOptions = {
                url: path("frontend.kmh.sales-channel.pickup-locations.index", { salesChannelId: context.salesChannel.id }),
                selectedPickupLocationId: context.extensions.pickupLocation.id,
                geolocationEnabled: config('KmhClickAndPickSW.config.enableGeolocationSorting') ? true : false
            } %}

            {% block component_shipping_method_label_kmh_self_pickup_field_container %}
            <div id="pickup-location-location-field-id-container"
                 class="mt-3"
                 data-sales-channel-pickup-location="true"
                 data-sales-channel-pickup-location-options="{{ salesChannelPickupLocationOptions|json_encode }}">
                {% block component_shipping_method_label_kmh_self_pickup_field_label %}
                    <label for="pickup-location-location-field-id">Select Pickup Location</label>
                {% endblock %}
                {% block component_shipping_method_label_kmh_self_pickup_location_field %}
                    <select id="pickup-location-location-field-id"
                            name="pickupLocationId"
                            class="form-control shipping-method-input"
                            {% if not enableSelection %}disabled{% endif %}>
                    </select>
                {% endblock %}
                {% block component_shipping_method_label_kmh_self_pickup_geolocation %}
                    {% if config('KmhClickAndPickSW.config.enableGeolocationSorting') %}
                        {# Shown by the JS plugin only with geolocation support + cookie consent. #}
                        <button type="button"
                                class="btn btn-link btn-sm px-0 mt-1"
                                data-pickup-location-geolocation
                                hidden>
                            {{ "general.kmh-click-and-pick.geolocation.useMyLocation" | trans }}
                        </button>
                        <div class="form-text"
                             data-pickup-location-geolocation-notice
                             role="status"
                             hidden>
                            {{ "general.kmh-click-and-pick.geolocation.locationUnavailable" | trans }}
                        </div>
                    {% endif %}
                {% endblock %}

                {% if context.extensions.pickupLocation.id is not null %}
                {% block component_shipping_method_label_kmh_self_pickup_time %}
                    {% set selectedPickupTime = context.extensions.pickupLocation.pickupTime %}
                    {% set selectedPickupComment = context.extensions.pickupLocation.pickupComment %}
                    {% set salesChannelPickupTimeOptions = {
                        url: path("frontend.kmh.sales-channel.pickup-locations.slots", { salesChannelId: context.salesChannel.id, locationId: context.extensions.pickupLocation.id }),
                        selectedPickupTime: selectedPickupTime
                    } %}
                    <div class="mt-3"
                         data-sales-channel-pickup-time="true"
                         data-sales-channel-pickup-time-options="{{ salesChannelPickupTimeOptions|json_encode }}">
                        {% block component_shipping_method_label_kmh_self_pickup_time_date %}
                            <label for="pickup-time-date-field-id">{{ "general.kmh-click-and-pick.pickupTimeField.dateLabel" | trans }}</label>
                            {# No name → helper only; drives the slots fetch and must not auto-submit the shipping form. #}
                            <input type="date"
                                   id="pickup-time-date-field-id"
                                   data-pickup-time-date
                                   class="form-control shipping-method-input">
                        {% endblock %}
                        {% block component_shipping_method_label_kmh_self_pickup_time_select %}
                            <label for="pickup-time-field-id" class="mt-2">{{ "general.kmh-click-and-pick.pickupTimeField.timeLabel" | trans }}</label>
                            <select id="pickup-time-field-id"
                                    name="pickupTime"
                                    data-pickup-time-select
                                    class="form-control shipping-method-input">
                                {% if selectedPickupTime %}
                                    <option value="{{ selectedPickupTime }}" selected>{{ selectedPickupTime|date('H:i', false) }}</option>
                                {% else %}
                                    <option value="">{{ "general.kmh-click-and-pick.pickupTimeField.placeholder" | trans }}</option>
                                {% endif %}
                            </select>
                        {% endblock %}
                        {% block component_shipping_method_label_kmh_self_pickup_time_comment %}
                            <label for="pickup-comment-field-id" class="mt-2">{{ "general.kmh-click-and-pick.pickupTimeField.commentLabel" | trans }}</label>
                            <textarea id="pickup-comment-field-id"
                                      name="pickupComment"
                                      rows="2"
                                      maxlength="500"
                                      placeholder="{{ "general.kmh-click-and-pick.pickupTimeField.commentPlaceholder" | trans }}"
                                      class="form-control shipping-method-input">{{ selectedPickupComment }}</textarea>
                        {% endblock %}
                    </div>
                {% endblock %}
                {% endif %}
            </div>
            {% endblock %}
            {% endblock %}
        {% endif %}
    {% endblock %}
    {% endif %}
{% endblock %}
